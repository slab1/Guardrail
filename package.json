{
  "name": "guardrail-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"python3 -m uvicorn app:app --host 0.0.0.0 --port 8888 --reload\" \"vite\"",
    "build": "node -e \"const fs=require('fs'); if(!fs.existsSync('firebase-applet-config.json') && fs.existsSync('firebase-applet-config.example.json')) fs.copyFileSync('firebase-applet-config.example.json', 'firebase-applet-config.json');\" && tsc && vite build",
    "lint": "eslint .",
    "start": "concurrently \"python3 -m uvicorn app:app --host 0.0.0.0 --port 8888\" \"vite\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "firebase": "^10.12.0",
    "framer-motion": "^11.2.10",
    "http-proxy-middleware": "^4.2.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.14"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    },
    "@grpc/grpc-js": "^1.14.0",
    "undici": "^6.29.1"
  }
}
