{
  "name": "guardrail-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"export PYTHONPATH=$PYTHONPATH:/root/.local/lib/python3.10/site-packages && /root/.local/bin/uvicorn app:app --host 0.0.0.0 --port 8888 --reload\" \"vite\"",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "start": "concurrently \"export PYTHONPATH=$PYTHONPATH:/root/.local/lib/python3.10/site-packages && /root/.local/bin/uvicorn app:app --host 0.0.0.0 --port 8888\" \"vite\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "firebase": "^10.12.0",
    "framer-motion": "^11.2.10",
    "http-proxy-middleware": "^4.2.1",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.23.15",
    "z3-solver": "^4.12.6"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.1"
  }
}
