# Guardrail Environment Variables
# Copy to .env and customize

# App
GUARDRAIL_APP_NAME=guardrail
GUARDRAIL_ENVIRONMENT=development
GUARDRAIL_DEBUG=true
GUARDRAIL_LOG_LEVEL=INFO

GUARDRAIL_DATA_DIR=/var/guardrail
GUARDRAIL_CONFIG_DIR=/etc/guardrail
GUARDRAIL_LOG_DIR=/var/log/guardrail

# MCP Gateway
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_ENABLE_TLS=false
MCP_CERT_PATH=
MCP_KEY_PATH=
MCP_MAX_CONNECTIONS=100
MCP_REQUEST_TIMEOUT=30

# Plan Compiler
PLAN_COMPILER_ENABLE_STATIC_VALIDATION=true
PLAN_COMPILER_ENABLE_REVERSIBILITY_CHECK=true
PLAN_COMPILER_MAX_PLAN_STEPS=100
PLAN_COMPILER_DEFAULT_TIMEOUT=300
PLAN_COMPILER_ALLOWED_MODELS=nvidia/nemotron-3-ultra-550b-a55b,gpt-4,claude-3

# Token Service
TOKEN_SERVICE_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_RANDOM_KEY
TOKEN_SERVICE_ALGORITHM=HS256
TOKEN_SERVICE_DEFAULT_TTL=3600
TOKEN_SERVICE_MAX_TTL=86400
TOKEN_SERVICE_ISSUER=guardrail

# Consent
CONSENT_REQUIRE_CONSENT_FOR_RISK=medium,high,critical
CONSENT_CONSENT_TTL=3600
CONSENT_AUTO_APPROVE_LOW_RISK=true
CONSENT_UI_CALLBACK_URL=

# PEP Framework
PEP_FS_ROOT=/var/guardrail/fs
PEP_FS_SNAPSHOT_INTERVAL=300
PEP_FS_MAX_SNAPSHOTS=100
PEP_FS_ENABLE_COMPRESSION=true

PEP_EXEC_KERNEL_PATH=/var/guardrail/firecracker/vmlinux
PEP_EXEC_ROOTFS_PATH=/var/guardrail/firecracker/rootfs.ext4
PEP_EXEC_CPU_COUNT=2
PEP_EXEC_MEMORY_MB=1024
PEP_EXEC_NETWORK_RATE_LIMIT=100Mbps

PEP_NET_DEFAULT_POLICY=deny
PEP_NET_ALLOWED_DOMAINS=api.github.com,pypi.org
PEP_NET_TLS_REQUIRED=true
PEP_NET_VERIFY_CERTIFICATES=true

# Causal Audit
CAUSAL_AUDIT_LOG_PATH=/var/guardrail/audit/causal.log
CAUSAL_AUDIT_MAX_LOG_SIZE_MB=1000
CAUSAL_AUDIT_RETENTION_DAYS=90
CAUSAL_AUDIT_ENABLE_HASH_CHAIN=true
CAUSAL_AUDIT_HASH_ALGORITHM=sha256
CAUSAL_AUDIT_ENABLE_EBPF=false

# Autopilot
AUTOPILOT_INITIAL_TRUST_SCORE=0.0
AUTOPILOT_TRUST_INCREMENT=0.5
AUTOPILOT_TRUST_DECREMENT=2.0
AUTOPILOT_ELEVATION_THRESHOLDS={"LOCKED": 0, "RESTRICTED": 10, "STANDARD": 50, "ELEVATED": 100, "AUTONOMOUS": 200}
AUTOPILOT_DECAY_RATE=0.01
AUTOPILOT_MAX_HISTORY=10000

# AuthZEN / Identity
AUTHZEN_PDP_ENDPOINT=http://localhost:8081
AUTHZEN_SPIFFE_TRUST_DOMAIN=guardrail.example.com
AUTHZEN_SPIFFE_SOCKET_PATH=/var/run/spire/socket
AUTHZEN_ENABLE_WORKLOAD_IDENTITY=true
AUTHZEN_CACHE_TTL=300

# Mesh Network
MESH_NODE_ID=guardrail-node
MESH_LISTEN_ADDRESS=0.0.0.0:9000
MESH_BOOTSTRAP_NODES=
MESH_HEARTBEAT_INTERVAL=5
MESH_NODE_TIMEOUT=30
MESH_ENABLE_MTLS=false
MESH_CERT_PATH=
MESH_KEY_PATH=

# Monitoring
MONITORING_SERVICE_NAME=guardrail
MONITORING_OTLP_ENDPOINT=http://localhost:4317
MONITORING_PROMETHEUS_PORT=9090
MONITORING_ENABLE_PROMETHEUS=true
MONITORING_ENABLE_OTLP=true
MONITORING_LOG_LEVEL=INFO
MONITORING_TRACE_SAMPLE_RATE=0.1
MONITORING_METRIC_INTERVAL=15

# Compliance
COMPLIANCE_ENABLE_AI_ACT=true
COMPLIANCE_ENABLE_NIST_AI_RMF=true
COMPLIANCE_ENABLE_ISO_42001=true
COMPLIANCE_EVIDENCE_PATH=/var/guardrail/compliance/evidence
COMPLIANCE_REPORT_PATH=/var/guardrail/compliance/reports
COMPLIANCE_AUDIT_RETENTION_DAYS=2555

# Advanced Security
ADV_SEC_HSM_TYPE=soft
ADV_SEC_HSM_PKCS11_LIB=
ADV_SEC_HSM_SLOT=0
ADV_SEC_HSM_PIN=
ADV_SEC_BIOMETRIC_TYPE=fido2
ADV_SEC_FIDO2_RP_ID=guardrail.example.com
ADV_SEC_FIDO2_ORIGIN=https://guardrail.example.com
ADV_SEC_ENABLE_CONTINUOUS_AUTH=true
ADV_SEC_AUTHZEN_ENDPOINT=http://localhost:8082

# Disaster Recovery
DR_BACKUP_PATH=/var/guardrail/backup
DR_BACKUP_INTERVAL=3600
DR_RETENTION_DAYS=30
DR_COMPRESSION=true
DR_ENCRYPTION=true
DR_REPLICATION_REGIONS=us-east-1,us-west-2,eu-west-1
DR_RPO_SECONDS=300
DR_RTO_SECONDS=3600

# Integration Testing
INT_TEST_MCP_SERVER_URL=
INT_TEST_LANGGRAPH_ENDPOINT=
INT_TEST_NEMOTRON_API_KEY=
INT_TEST_TEST_TIMEOUT=60
INT_TEST_PARALLEL_TESTS=4